   "source": [
    "%sql\n",
    "CREATE OR REPLACE TABLE mlo.features.automl_v3 AS\n",
    "SELECT f.*, l.Bad\n",
    "FROM mlo.features.weather_daily_v3 VERSION AS OF 0 AS f\n",
    "JOIN mlo.features.weather_labels AS l\n",
    "  ON f.date = l.date AND f.station = l.station"
   ]
  }
